{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Streamlit app",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "app.py"],
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Ingest manual",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/ingest.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Ask (interactive)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/ask.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Evaluate",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/evaluate.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
