# Copy to .env and fill in ONE key. Never commit .env.

# Option A - Groq (free tier): chat on Groq, embeddings run locally (no key needed)
GROQ_API_KEY=

# Option B - OpenAI: chat and embeddings on OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # only for an OpenAI-compatible proxy

# The provider is detected from the key. Set it explicitly if both keys are present:
# LLM_PROVIDER=groq           # groq | openai

# Optional overrides (defaults shown for Groq / OpenAI)
# CHAT_MODEL=openai/gpt-oss-120b         # gpt-4o-mini
# JUDGE_MODEL=<same as CHAT_MODEL>
# REASONING_EFFORT=low                    # (unset)  gpt-oss: low|medium|high; qwen3: none|default
# MAX_TOKENS=2048                         # 512
# EMBEDDING_PROVIDER=huggingface             # openai
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5     # text-embedding-3-small
# MANUAL_PDF=data/medical_diagnosis_manual.pdf
# MANUAL_NAME=The Merck Manual of Diagnosis & Therapy
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=3
